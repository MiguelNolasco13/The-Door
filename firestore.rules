rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function activeUser() {
      return profileExists()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == "active";
    }
    function isOwner() {
      return activeUser()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "owner";
    }
    function hasActiveMembership(condominioId) {
      return activeUser()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.condominioId == condominioId;
    }

    match /usuarios/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      // O proprietário administra os perfis existentes. Um usuário também pode
      // criar o próprio perfil somente quando houver um convite válido para o
      // mesmo e-mail e condomínio. O cliente não pode escolher livremente o tenant.
      allow create: if isOwner()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "active"
          && exists(/databases/$(database)/documents/convites/$(request.auth.token.email))
          && get(/databases/$(database)/documents/convites/$(request.auth.token.email)).data.email == request.auth.token.email
          && get(/databases/$(database)/documents/convites/$(request.auth.token.email)).data.condominioId == request.resource.data.condominioId
          && get(/databases/$(database)/documents/convites/$(request.auth.token.email)).data.status != "cancelado");
      allow update, delete: if isOwner() || (signedIn() && request.auth.uid == userId && request.resource.data.condominioId == resource.data.condominioId);
    }

    match /convites/{inviteId} {
      allow get: if isOwner()
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow list: if isOwner();
      allow create, update: if isOwner();
      allow delete: if isOwner();
    }

    match /condominios/{condominioId} {
      allow read: if isOwner() || hasActiveMembership(condominioId);
      allow create, update, delete: if isOwner();
      match /dados/{docId} {
        allow read, write: if isOwner() || hasActiveMembership(condominioId);
      }
    }

    match /admin_logs/{logId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.autorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}